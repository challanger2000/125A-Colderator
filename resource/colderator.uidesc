<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Bg" rgba="#ECF4F8FF"/>
    <color name="Text" rgba="#173646FF"/>
    <color name="Muted" rgba="#6E8795FF"/>
    <color name="PanelTitle" rgba="#3F7896FF"/>
    <color name="Display" rgba="#FBFDFEFF"/>
    <color name="DisplayText" rgba="#173646FF"/>
    <color name="DisplayFrame" rgba="#9CC9E0FF"/>
  </colors>

  <template background-color="Bg" class="CViewContainer" maxSize="800, 560" minSize="800, 560"
            mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="800, 560" transparent="false">
    <view class="CView" custom-view-name="Faceplate" origin="0, 0" size="800, 560" mouse-enabled="false"/>

    <view class="CView" custom-view-name="BrandLogo" origin="28, 17" size="116, 54" mouse-enabled="false"/>
    <view back-color="Bg" class="CTextLabel" font="~ NormalFontVeryBig" font-color="Text"
          frame-width="0" origin="186, 18" size="576, 28" title="COLDERATOR"
          transparent="true" text-alignment="right"/>
    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Muted"
          frame-width="0" origin="186, 47" size="576, 16" title="The Frozen Machine"
          transparent="true" text-alignment="right"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="43, 104" size="84, 18" title="COLD"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Cold" origin="25, 125" size="120, 120"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="183, 112" size="84, 18" title="ICE"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Ice" origin="181, 141" size="88, 88"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="303, 112" size="84, 18" title="METAL"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Metal" origin="301, 141" size="88, 88"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="423, 112" size="84, 18" title="FROST"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Frost" origin="421, 141" size="88, 88"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="543, 112" size="84, 18" title="SHIVER"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Shiver" origin="541, 141" size="88, 88"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="663, 112" size="84, 18" title="SPACE"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Space" origin="661, 141" size="88, 88"/>

    <view back-color="Display" class="COptionMenu" control-tag="IceMaterial"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="177, 336" round-rect-radius="8" size="96, 27"
          style-round-rect="true" transparent="true"/>
    <view back-color="Display" class="COptionMenu" control-tag="MetalMaterial"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="297, 336" round-rect-radius="8" size="96, 27"
          style-round-rect="true" transparent="true"/>
    <view back-color="Display" class="COptionMenu" control-tag="FrostMaterial"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="417, 336" round-rect-radius="8" size="96, 27"
          style-round-rect="true" transparent="true"/>
    <view back-color="Display" class="COptionMenu" control-tag="ShiverMaterial"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="537, 336" round-rect-radius="8" size="96, 27"
          style-round-rect="true" transparent="true"/>
    <view back-color="Display" class="COptionMenu" control-tag="SpaceMaterial"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="657, 336" round-rect-radius="8" size="96, 27"
          style-round-rect="true" transparent="true"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="PanelTitle"
          frame-width="0" origin="34, 405" size="224, 18" title="ATMOSPHERE A"
          transparent="true" text-alignment="center"/>
    <view back-color="Display" class="COptionMenu" control-tag="AtmosAType"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="36, 439" round-rect-radius="8" size="134, 30"
          style-round-rect="true" transparent="true"/>
    <view class="CView" custom-view-name="AtmosAAmount" origin="192, 421" size="72, 72"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="PanelTitle"
          frame-width="0" origin="314, 405" size="224, 18" title="ATMOSPHERE B"
          transparent="true" text-alignment="center"/>
    <view back-color="Display" class="COptionMenu" control-tag="AtmosBType"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="316, 439" round-rect-radius="8" size="134, 30"
          style-round-rect="true" transparent="true"/>
    <view class="CView" custom-view-name="AtmosBAmount" origin="472, 421" size="72, 72"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Text"
          frame-width="0" origin="620, 405" size="88, 18" title="OUTPUT"
          transparent="true" text-alignment="center"/>
    <view class="CView" custom-view-name="Output" origin="620, 415" size="88, 88"/>

  </template>

  <control-tags>
    <control-tag name="Cold" tag="100"/>
    <control-tag name="Ice" tag="101"/>
    <control-tag name="Metal" tag="102"/>
    <control-tag name="Frost" tag="103"/>
    <control-tag name="Shiver" tag="104"/>
    <control-tag name="Space" tag="105"/>
    <control-tag name="Output" tag="106"/>
    <control-tag name="Bypass" tag="107"/>
    <control-tag name="IceMaterial" tag="108"/>
    <control-tag name="MetalMaterial" tag="109"/>
    <control-tag name="FrostMaterial" tag="110"/>
    <control-tag name="ShiverMaterial" tag="111"/>
    <control-tag name="SpaceMaterial" tag="112"/>
    <control-tag name="AtmosAType" tag="113"/>
    <control-tag name="AtmosAAmount" tag="114"/>
    <control-tag name="AtmosBType" tag="115"/>
    <control-tag name="AtmosBAmount" tag="116"/>
  </control-tags>
</vstgui-ui-description>

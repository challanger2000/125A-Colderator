<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Bg" rgba="#ECF4F8FF"/>
    <color name="Text" rgba="#173646FF"/>
    <color name="Muted" rgba="#6E8795FF"/>
    <color name="Ice" rgba="#1495D0FF"/>
    <color name="PanelTitle" rgba="#3F7896FF"/>
    <color name="Display" rgba="#F8FCFEFF"/>
    <color name="DisplayText" rgba="#173646FF"/>
    <color name="DisplayFrame" rgba="#B3D2E2FF"/>
  </colors>

  <template background-color="Bg" class="CViewContainer" maxSize="800, 460" minSize="800, 460"
            mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="800, 460" transparent="false">
    <view class="CView" custom-view-name="Faceplate" origin="0, 0" size="800, 460" mouse-enabled="false"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontVeryBig" font-color="Text"
          frame-width="0" origin="28, 12" size="300, 30" title="125A COLDERATOR"
          transparent="true" text-alignment="left"/>
    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="Muted"
          frame-width="0" origin="30, 43" size="410, 18"
          title="ANALOG WARMTH IS OVER — WELCOME TO DIGITAL COLD"
          transparent="true" text-alignment="left"/>

    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="PanelTitle"
          frame-width="0" origin="42, 101" size="176, 18" title="COLD ENGINE"
          transparent="true" text-alignment="center"/>
    <view back-color="Bg" class="CTextLabel" font="~ NormalFontSmall" font-color="PanelTitle"

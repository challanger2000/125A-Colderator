<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Text" rgba="#EAF7FFFF"/>
    <color name="Muted" rgba="#B8D5E5FF"/>
    <color name="Display" rgba="#152B3BE8"/>
    <color name="DisplayText" rgba="#EEF9FFFF"/>
    <color name="DisplayFrame" rgba="#8EB5C9FF"/>
    <color name="ButtonText" rgba="#EAF7FFFF"/>
    <color name="ButtonTextOn" rgba="#FFFFFFFF"/>
  </colors>

  <gradients>
    <gradient name="BypassOff">
      <color-stop rgba="#263E4DDD" start="0"/>
      <color-stop rgba="#122633EE" start="1"/>
    </gradient>
    <gradient name="BypassOn">
      <color-stop rgba="#DDF6FFFF" start="0"/>
      <color-stop rgba="#73CAEFFF" start="1"/>
    </gradient>
  </gradients>

  <template background-color="#07131BFF" class="CViewContainer" maxSize="800, 560" minSize="800, 560"
            mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="800, 560" transparent="false">
    <view class="CView" custom-view-name="Faceplate" origin="0, 0" size="800, 560" mouse-enabled="false"/>

    <!-- Dark recessed plaque gives the authoritative 125A master logo enough contrast. -->
    <view back-color="#0A1722D9" class="CTextLabel" frame-color="DisplayFrame" frame-width="1"
          origin="24, 14" round-rect-radius="10" size="145, 58" style-round-rect="true"
          title="" transparent="false"/>
    <view class="CView" custom-view-name="BrandLogo" origin="35, 20" size="120, 46" mouse-enabled="false"/>

    <!-- ZOOM and BYPASS deliberately share one visual language and dimensions. -->
    <view class="CView" custom-view-name="Zoom" origin="626, 24" size="78, 22"/>
    <view class="CTextButton" control-tag="Bypass" origin="708, 24" size="78, 22"
          title="BYPASS" font="~ NormalFontSmaller" text-color="ButtonText"
          text-color-highlighted="ButtonTextOn" frame-color="DisplayFrame"
          frame-color-highlighted="DisplayFrame" frame-width="1" round-radius="8"
          kick-style="false" gradient="BypassOff" gradient-highlighted="BypassOn"/>

    <!-- Knobs aligned to measured optical centers of the faceplate recesses. -->
    <view class="CView" custom-view-name="Cold" origin="52, 146" size="120, 120"/>
    <view class="CView" custom-view-name="Ice" origin="210, 147" size="88, 88"/>
    <view class="CView" custom-view-name="Metal" origin="326, 150" size="88, 88"/>
    <view class="CView" custom-view-name="Frost" origin="443, 150" size="88, 88"/>
    <view class="CView" custom-view-name="Shiver" origin="560, 146" size="88, 88"/>
    <view class="CView" custom-view-name="Space" origin="675, 147" size="88, 88"/>

    <!-- Material selectors fitted to the engraved faceplate slots. -->
    <view back-color="Display" class="COptionMenu" control-tag="IceMaterial"
          font="~ NormalFontSmaller" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="220, 258" round-rect-radius="5" size="70, 22"
          style-round-rect="true" transparent="false"/>
    <view back-color="Display" class="COptionMenu" control-tag="MetalMaterial"
          font="~ NormalFontSmaller" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="335, 258" round-rect-radius="5" size="70, 22"
          style-round-rect="true" transparent="false"/>
    <view back-color="Display" class="COptionMenu" control-tag="FrostMaterial"
          font="~ NormalFontSmaller" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="452, 258" round-rect-radius="5" size="70, 22"
          style-round-rect="true" transparent="false"/>
    <view back-color="Display" class="COptionMenu" control-tag="ShiverMaterial"
          font="~ NormalFontSmaller" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="569, 258" round-rect-radius="5" size="70, 22"
          style-round-rect="true" transparent="false"/>
    <view back-color="Display" class="COptionMenu" control-tag="SpaceMaterial"
          font="~ NormalFontSmaller" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="686, 258" round-rect-radius="5" size="70, 22"
          style-round-rect="true" transparent="false"/>

    <view class="CView" custom-view-name="AtmosAAmount" origin="66, 381" size="88, 88"/>
    <view back-color="Display" class="COptionMenu" control-tag="AtmosAType"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="173, 416" round-rect-radius="6" size="135, 26"
          style-round-rect="true" transparent="false"/>

    <view class="CView" custom-view-name="AtmosBAmount" origin="377, 381" size="88, 88"/>
    <view back-color="Display" class="COptionMenu" control-tag="AtmosBType"
          font="~ NormalFontSmall" font-color="DisplayText" frame-color="DisplayFrame"
          frame-width="1" origin="481, 416" round-rect-radius="6" size="135, 26"
          style-round-rect="true" transparent="false"/>

    <view class="CView" custom-view-name="Output" origin="666, 379" size="88, 88"/>
  </template>

  <control-tags>
    <control-tag name="Cold" tag="100"/>
    <control-tag name="Ice" tag="101"/>
    <control-tag name="Metal" tag="102"/>
    <control-tag name="Frost" tag="103"/>
    <control-tag name="Shiver" tag="104"/>
    <control-tag name="Space" tag="105"/>
    <control-tag name="Output" tag="106"/>
    <control-tag name="Bypass" tag="107"/>
    <control-tag name="IceMaterial" tag="108"/>
    <control-tag name="MetalMaterial" tag="109"/>
    <control-tag name="FrostMaterial" tag="110"/>
    <control-tag name="ShiverMaterial" tag="111"/>
    <control-tag name="SpaceMaterial" tag="112"/>
    <control-tag name="AtmosAType" tag="113"/>
    <control-tag name="AtmosAAmount" tag="114"/>
    <control-tag name="AtmosBType" tag="115"/>
    <control-tag name="AtmosBAmount" tag="116"/>
  </control-tags>
</vstgui-ui-description>
